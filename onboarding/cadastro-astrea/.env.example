# -------------------------------------------------------------------------
# Configuração da automação de cadastro no Astrea
#
# Este arquivo é só um MODELO. O arquivo de verdade fica em:
#     ~/.cadastro-astrea/.env
# fora do Google Drive, porque o Drive sincroniza para a nuvem e para outras
# máquinas — e senha de sistema jurídico não deve viajar.
#
# NUNCA preencha credenciais reais aqui neste .env.example.
# -------------------------------------------------------------------------

# --- Segurança do modo de operação ---------------------------------------
# true  = lê, extrai, valida, consulta duplicidade... e NÃO grava no Astrea
# false = produção; passa a cadastrar de verdade
TEST_MODE=true

# --- Acesso ao Astrea -----------------------------------------------------
# O Astrea não tem API pública. A automação entra pela tela, com a sua conta.
# adaptador: navegador | planilha | dry-run
ASTREA_ADAPTADOR=navegador
ASTREA_URL=https://astrea.net.br/#/login/BR

# chrome = o Google Chrome instalado na máquina | chromium = o do Playwright
ASTREA_NAVEGADOR=chrome

# RECOMENDADO: perfil próprio. A sessão do Astrea fica salva num perfil do
# Chrome criado só para a automação (~/.cadastro-astrea/chrome-perfil). Você
# entra UMA vez à mão (menu 7, ou 'executar.py entrar') e a senha NÃO precisa
# ser guardada em lugar nenhum. Também resolve o 2FA, se um dia ligar.
ASTREA_PERFIL_PROPRIO=true

# Só use estes dois se preferir o login automático em vez do perfil próprio.
# Guardar senha em arquivo é sempre pior; deixe vazio se usar o perfil.
ASTREA_EMAIL=
ASTREA_SENHA=

# true mostra a janela do navegador (útil para acompanhar)
ASTREA_NAVEGADOR_VISIVEL=false
ASTREA_TIMEOUT_MS=30000
# Pausa entre um cliente e outro, em segundos (ritmo humano, sem rajada)
ASTREA_PAUSA_ENTRE_CLIENTES_S=3
# Criar também o caso/pasta, além do contato.
# Desligado por ora: o escopo atual é só o cadastro do cliente. O tipo de ação
# e o banco adverso continuam sendo lidos do contrato e aparecem no relatório,
# na coluna "Caso a abrir". Ligar só depois de calibrar a tela de casos.
ASTREA_CRIAR_CASO=false

# --- Pastas ---------------------------------------------------------------
# Em branco = usa a pasta PREPARAÇÃO PARA INGRESSO ao lado deste projeto
PASTA_CLIENTES=
# Em branco = ~/.cadastro-astrea
PASTA_DADOS=
BANCO_ARQUIVO=controle.sqlite3

# --- Regras de negócio ----------------------------------------------------
# Campo crítico abaixo desta confiança vai para conferência humana
LIMIAR_CONFIANCA=0.80
# Sem estes campos o cliente NÃO é cadastrado
CAMPOS_OBRIGATORIOS=nome,cpf
# Extrair o Cliente Responsável (corresponsável) para o relatório
EXTRAIR_CORRESPONSAVEL=true
# Cadastrar também o corresponsável no Astrea (decisão atual: não)
CADASTRAR_CORRESPONSAVEL=false

# --- Vigilância da pasta --------------------------------------------------
# Minutos que a pasta precisa ficar parada antes de ser lida (evita pegar o
# cliente no meio do upload dos documentos)
MINUTOS_ESTABILIDADE=10
# Horários em que a automação roda sozinha.
#
# São horários fixos, e não "de X em X minutos", por uma limitação do Astrea:
# ele aceita SÓ UMA sessão por conta. Rodando durante o expediente, a automação
# e você ficariam se derrubando do sistema o dia inteiro (foi medido: a sessão
# da automação caiu no instante em que a advogada entrou no Astrea).
# Por isso: cedo, antes do expediente, e à noite, depois.
HORARIOS=06:00,21:00
MAX_TENTATIVAS=3

# --- Privacidade / LGPD ---------------------------------------------------
# Captura de tela do navegador: nunca | erro | sempre
SALVAR_EVIDENCIA=erro
MASCARAR_CPF_NO_LOG=true
# Log apagado automaticamente depois deste prazo
DIAS_RETENCAO_LOG=180
