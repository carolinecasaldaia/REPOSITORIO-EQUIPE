# -------------------------------------------------------------------------
# Configuração da automação "Baixar Contratos Assinados" (Autentique)
#
# Este arquivo é só um MODELO. O de verdade fica em:
#     ~/.baixar-autentique/.env
# fora do Google Drive, porque o Drive sincroniza para a nuvem e para outras
# máquinas — e a chave da API dá acesso a TODOS os documentos do escritório.
#
# NUNCA escreva a chave real aqui neste .env.example.
# -------------------------------------------------------------------------

# --- Acesso ao Autentique -------------------------------------------------
# Gerada no painel do Autentique: Configurações → Chaves de API.
# Use o menu do atalho ("Guardar a chave da API") em vez de editar à mão.
AUTENTIQUE_TOKEN=

AUTENTIQUE_API=https://api.autentique.com.br/v2/graphql
TIMEOUT_S=60

# Quantos documentos olhar por rodada: 60 por página × 5 páginas = 300 mais
# recentes. Aumente só se o escritório passar a assinar muito mais que isso
# entre duas verificações.
ITENS_POR_PAGINA=60
MAX_PAGINAS=5

# Opcional: id de uma pasta do Autentique, para olhar só ela.
PASTA_AUTENTIQUE_ID=

# Opcional: só considerar documentos cujo nome case com esta expressão.
# Ex.: CONTRATO   (deixe vazio para considerar todos)
FILTRO_NOME=

# --- Pastas ---------------------------------------------------------------
# Em branco = a pasta PREPARAÇÃO PARA INGRESSO ao lado deste projeto
PASTA_CLIENTES=
# Em branco = ~/.baixar-autentique
PASTA_DADOS=
# Em branco = a pasta RELATÓRIOS deste projeto
PASTA_RELATORIOS=
# Em branco = ONBOARDING/SEPARADOR AUTENTIQUE/separar_autentique.py
SEPARADOR=
# Em branco = ONBOARDING/GERADOR ONBOARDING/gerar_onboarding.py
GERADOR_ONBOARDING=
# Em branco = ~/.gerador-onboarding/venv/bin/python (o ambiente do gerador)
PYTHON_ONBOARDING=

# --- Quem é o escritório --------------------------------------------------
# Signatário com estes e-mails/domínios não é o cliente — é você.
EMAILS_ESCRITORIO=contato@carolinemacedoadv.com
DOMINIOS_ESCRITORIO=carolinemacedoadv.com

# --- Regras ---------------------------------------------------------------
# Semelhança mínima entre o nome do signatário e o nome da pasta do cliente.
# 0.88 aceita erro de digitação ("ANDESON" x "ANDERSON") sem trocar de cliente.
LIMIAR_NOME=0.88
# Cliente sem pasta: criar <MÊS ANO>/<NOME> com as 5 subpastas.
CRIAR_PASTA=true
# Separar o envelope em contrato / procuração / hipossuficiência / residência.
SEPARAR=true
# Gerar também o PDF de onboarding do cliente logo depois de arquivar.
# Nas buscas e apreensões o banco adverso não consta no contrato: nesses casos
# o onboarding fica pendente no relatório, para você terminar pelo atalho.
GERAR_ONBOARDING=true
# Avisar na tela do Mac quando chegar contrato (ou quando algo precisar de você)
AVISAR_NA_TELA=true
TIMEOUT_ONBOARDING_S=300
# Padrão do menu "baixar contratos de antes".
DIAS_HISTORICO=30
# Quanto tempo o PDF sem dono fica guardado em ~/.baixar-autentique/quarentena.
DIAS_QUARENTENA=60

# --- Quando rodar sozinha -------------------------------------------------
# De hora em hora, das 8h às 20h, no minuto 10.
HORA_INICIO=8
HORA_FIM=20
MINUTO=10
