# -------------------------------------------------------------------------
# Configuração da automação "Meta Ads"
#
# Este arquivo é só um MODELO. O de verdade fica em:
#     ~/.meta-ads/.env   (permissão 600)
# fora do repositório e do Google Drive: o token gerencia anúncios, páginas
# e WhatsApp Business do escritório.
#
# NUNCA escreva o token real aqui. Use:  python3 executar.py chave
# -------------------------------------------------------------------------

# Token do System User "AUTOMAÇÕES" (Business Manager → Usuários do sistema).
# Não expira; precisa de ads_management e ads_read.
META_TOKEN=

# Versão da Graph API. Cada versão dura ~2 anos; ao vencer, suba o número.
META_API_VERSAO=v24.0

# Conta de anúncios padrão (a principal, em America/Maceio).
META_CONTA=act_855669012556336
