# ---------------------------------------------------------------------------
# RADAR B&A — modelo de configuração.
# O arquivo real fica em ~/.radar-ba/.env, FORA do Google Drive, para que os
# segredos não sejam sincronizados. Este .exemplo não contém segredo nenhum.
# ---------------------------------------------------------------------------

# Chave pública da API do DataJud, divulgada pelo próprio CNJ.
# Fica aqui e não no código porque o CNJ pode rotacioná-la a qualquer momento.
DATAJUD_API_KEY=

# Ritmo das consultas (requisições por minuto).
# DJEN: o servidor publica x-ratelimit-limit=20. Usamos 18 por margem.
DJEN_RPM=18
DATAJUD_RPM=60

# --- e-SAJ -----------------------------------------------------------------
# DESLIGADO por padrão. Só ligue depois de analisar os Termos de Uso de cada
# tribunal. A ausência de CAPTCHA é um fato técnico, não uma autorização.
ESAJ_HABILITADO=false
ESAJ_INTERVALO_S=5

# --- Segurança do CPF ------------------------------------------------------
# CPF_PEPPER: sal fixo do hash determinístico. Se mudar, todos os hashes mudam.
# CPF_CHAVE : chave AES-256-GCM em base64 (32 bytes).
# Gere as duas com:  python3 executar.py gerar-chaves
CPF_PEPPER=
CPF_CHAVE=

RETENCAO_DIAS=1825
LOG_NIVEL=INFO
